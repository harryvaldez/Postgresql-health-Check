      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"output\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Issue\": {\n            \"type\": \"string\"\n          },\n          \"Priority\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {\n            \"type\": \"string\"\n          },\n          \"Immediate remediation steps\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"Preventative actions and proactive monitoring improvements\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"Issue\",\n          \"Priority\",\n          \"Description\",\n          \"Immediate remediation steps\",\n          \"Preventative actions and proactive monitoring improvements\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"output\"\n  ]\n}"
