    {
      "parameters": {
        "jsCode": "const jiraTasks = [];\nconst inputItems = $input.all();\n\nfor (const item of inputItems) {\n    if (item.json.output && Array.isArray(item.json.output)) {\n        for (const issue of item.json.output) {\n            const description = [\n                `Description`,\n                issue.Description || 'No description provided.',\n                ``,\n                `Immediate Remediation Steps`\n            ].concat(issue['Immediate remediation steps'] || ['No immediate remediation steps provided.']).map(step => ` ${step}`)\n            .concat([\n                ``,\n                `Preventative Actions and Proactive Monitoring Improvements`\n            ])\n            .concat(issue['Preventative actions and proactive monitoring improvements'] || ['No preventative actions provided.']).map(action => ` ${action}`)\n            .join(String.fromCharCode(10));\n\n            // Map priority: Critical=1, High=2, Medium=3\n            const priStr = (issue.Priority || 'Medium').toLowerCase();\n            const priorityMap = { critical: 1, high: 2, medium: 3 };\n            const numericPriority = priorityMap[priStr] ?? 3;\n\n            // Only create Jira tasks for priority 1 (Critical) and 2 (High)\n            if (numericPriority <= 3) {\n                const task = {\n                    summary: issue.Issue || 'No summary provided.',\n                    description: description,\n                    priority: numericPriority,\n                    labels: (issue.Issue || '').toLowerCase().split(' ').map(l => l.replace(/[^a-z0-9]/g, ''))\n                };\n                jiraTasks.push({ json: task });\n            }\n            // Else: skip Medium (3) and lower priorities\n        }\n    }\n}\n\nreturn jiraTasks;\n"
      },
