    {
      "parameters": {
        "jsCode": "// System Health Data Splitter\nconst inputData = $input.first().json;\nconst body = inputData.body ?? inputData;\n\nconst systemHealthData = {\n  server: body.summary?.server ?? 'Unknown',\n  timestamp: body.summary?.timestamp,\n  system: body.system ?? {},\n  performance: body.performance ?? {},\n  summary: {\n    server: body.summary?.server,\n    timestamp: body.summary?.timestamp,\n    disk_usage_percent: body.summary?.disk_usage_percent,\n    load_avg_1min: body.summary?.load_avg_1min,\n    memory_used_percent: body.summary?.memory_used_percent,\n    total_connections: body.summary?.total_connections,\n    active_connections: body.summary?.active_connections,\n    cache_hit_ratio: body.summary?.cache_hit_ratio,\n    deadlocks: body.summary?.deadlocks\n  }\n};\n\nreturn [{ json: systemHealthData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5616,
        1008
      ],
      "id": "56684d4a-8dfa-4a5c-881e-46e989b80902",
      "name": "System Health Splitter"
    },
    {
      "parameters": {
        "jsCode": "// Database Performance Data Splitter\nconst inputData = $input.first().json;\nconst body = inputData.body ?? inputData;\n\nconst dbPerformanceData = {\n  server: body.summary?.server ?? 'Unknown',\n  timestamp: body.summary?.timestamp,\n  database: body.database ?? {},\n  locks: {\n    waiting_sessions: body.locks?.waiting_sessions ?? 0,\n    top_waiters: (body.locks?.top_waiters ?? []).slice(0, 5),\n    blocking_chains: (body.locks?.blocking_chains ?? []).slice(0, 5)\n  },\n  vacuum: {\n    top_dead_tuples: (body.vacuum?.top_dead_tuples ?? []).slice(0, 5)\n  },\n  bloat: {\n    top_bloated_tables: (body.bloat?.top_bloated_tables ?? []).slice(0, 5),\n    large_indexes: (body.bloat?.large_indexes ?? []).slice(0, 5)\n  }\n};\n\nreturn [{ json: dbPerformanceData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5616,
        624
      ],
      "id": "b2745539-04e0-4c4f-8dd1-d9e26db724a0",
      "name": "DB Performance Splitter"
    },
    {
      "parameters": {
        "jsCode": "// Backup & Recovery Data Splitter\nconst inputData = $input.first().json;\nconst body = inputData.body ?? inputData;\n\nconst backupRecoveryData = {\n  server: body.summary?.server ?? 'Unknown',\n  timestamp: body.summary?.timestamp,\n  backup: body.backup ?? {},\n  wal: body.wal ?? {},\n  replication: body.replication ?? {},\n  archive_mode: body.summary?.archive_mode\n};\n\nreturn [{ json: backupRecoveryData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5616,
        816
      ],
      "id": "9f0eda65-0750-4c86-9935-f223e976d337",
      "name": "Backup Recovery Splitter"
    },
    {
      "parameters": {
        "jsCode": "// Security & Compliance Data Splitter\nconst inputData = $input.first().json;\nconst body = inputData.body ?? inputData;\n\nconst securityAlerts = (body.alerts ?? []).filter(alert => \n  alert.code?.includes('security') || \n  alert.code?.includes('auth') || \n  alert.code?.includes('privilege') ||\n  alert.severity === 'critical'\n);\n\nconst securityData = {\n  server: body.summary?.server ?? 'Unknown',\n  timestamp: body.summary?.timestamp,\n  configuration: body.configuration ?? {},\n  security_alerts: securityAlerts,\n  all_alerts: body.alerts ?? []\n};\n\nreturn [{ json: securityData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5616,
        1312
      ],
      "id": "13cdac6c-e1d3-4a4b-8ba6-67623725a9a4",
      "name": "Security Compliance Splitter"
    },
    {
      "parameters": {
        "jsCode": "// Storage & Capacity Data Splitter\nconst inputData = $input.first().json;\nconst body = inputData.body ?? inputData;\n\nconst storageData = {\n  server: body.summary?.server ?? 'Unknown',\n  timestamp: body.summary?.timestamp,\n  storage_summary: body.storage_summary ?? {},\n  disk_usage_percent: body.summary?.disk_usage_percent,\n  storage: body.storage ?? {},\n  largest_tables: (body.storage?.largest_tables ?? []).slice(0, 10),\n  largest_indexes: (body.storage?.largest_indexes ?? []).slice(0, 10)\n};\n\nreturn [{ json: storageData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5616,
        1600
      ],
      "id": "fe16ab24-933b-43c3-abb4-2632f88c4957",
      "name": "Storage Capacity Splitter"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are a System Performance Analyst specializing in PostgreSQL infrastructure monitoring.\n\nInput: Using 'taskbreakdown' tool, analyze the provided system health metrics for PostgreSQL/EnterpriseDB Advanced Server 9.6.\n\n**Server Info:**\n- Server: {{ $json.server }}\n- Timestamp: {{ $json.timestamp }}\n\n**System Metrics:**\n{{ JSON.stringify($json.system, null, 2) }}\n\n**Performance Metrics:**\n{{ JSON.stringify($json.performance, null, 2) }}\n\n**Server Summary:**\n{{ JSON.stringify($json.summary, null, 2) }}\n\n**Analysis Requirements:**\n1. Focus on system-level performance issues (CPU, memory, disk I/O)\n2. Identify resource bottlenecks and capacity constraints\n3. Assess overall system health and stability\n4. Evaluate connection management and resource utilization\n5. Prioritize findings by system impact (Critical, High, Medium, Low)\n\n**Output Format:**\nProvide a focused analysis of system health issues with:\n- Issue title and priority\n- Brief description of the system problem\n- Specific remediation steps for system-level fixes\n- Preventive monitoring recommendations\n- Focus on infrastructure and resource management\n\nExpectation: Use the format_final_json_response tool to output a list of system health issues only.",
        "options": {
          "systemMessage": "You are a System Performance Analyst specializing in PostgreSQL infrastructure monitoring with expertise in:\n- System resource optimization and capacity planning\n- CPU, memory, and disk I/O performance analysis\n- Connection pooling and resource management\n- System-level troubleshooting and diagnostics\n- Infrastructure performance tuning\n\nAnalyze system health metrics and generate actionable insights focused on:\n- System resource utilization and bottlenecks\n- Infrastructure performance optimization\n- Capacity planning and scaling recommendations\n- System stability and reliability issues\n\nStructure your response to facilitate creation of prioritized Jira tasks for system infrastructure improvements."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5904,
        1008
      ],
      "id": "ecb29c17-12ac-488a-a3ac-d0880ba202bc",
      "name": "System Health Agent",
      "executeOnce": false,
      "retryOnFail": false
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are a Database Performance Expert specializing in PostgreSQL query optimization and lock analysis.\n\nInput: Using 'taskbreakdown' tool, analyze the provided database performance metrics for PostgreSQL/EnterpriseDB Advanced Server 9.6.\n\n**Server Info:**\n- Server: {{ $json.server }}\n- Timestamp: {{ $json.timestamp }}\n\n**Database Metrics:**\n{{ JSON.stringify($json.database, null, 2) }}\n\n**Lock Analysis:**\n{{ JSON.stringify($json.locks, null, 2) }}\n\n**Vacuum Operations:**\n{{ JSON.stringify($json.vacuum, null, 2) }}\n\n**Table/Index Bloat:**\n{{ JSON.stringify($json.bloat, null, 2) }}\n\n**Analysis Requirements:**\n1. Use 'taskbreakdown' tool for analysis.  Focus on database-specific performance bottlenecks\n2. Analyze lock contention and blocking issues\n3. Evaluate vacuum operation effectiveness\n4. Assess table and index bloat impact on performance\n5. Identify query performance optimization opportunities\n6. Prioritize findings by performance impact (Critical, High, Medium, Low)\n\n**Output Format:**\nProvide a focused analysis of database performance issues with:\n- Issue title and priority\n- Brief description of the database performance problem\n- Specific remediation steps for database optimization such as query tuning and indexing recommendations.\n- Preventive maintenance and monitoring improvements\n\nExpectation: Use the format_final_json_response tool to output a list of database performance issues only.",
        "options": {
          "systemMessage": "You are a Database Performance Expert specializing in PostgreSQL optimization with expertise in:\n- Query performance analysis and optimization\n- Lock contention and deadlock resolution\n- Index optimization and maintenance\n- Vacuum and autovacuum tuning\n- Table bloat detection and remediation\n- Database configuration tuning\n\nAnalyze database performance metrics and generate actionable insights focused on:\n- Query execution efficiency and bottlenecks\n- Lock management and contention issues\n- Index usage and optimization opportunities\n- Vacuum operation effectiveness\n- Table and index bloat impact\n\nStructure your response to facilitate creation of prioritized Jira tasks for database performance improvements."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5904,
        624
      ],
      "id": "8f63edd4-5d02-4208-b70e-113c1ab6f03c",
      "name": "DB Performance Agent",
      "executeOnce": false,
      "retryOnFail": false
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are a Disaster Recovery Specialist focusing on PostgreSQL backup integrity and replication health.\n\nInput: Using 'taskbreakdown' tool, analyze the provided backup and recovery metrics for PostgreSQL/EnterpriseDB Advanced Server 9.6.\n\n**Server Info:**\n- Server: {{ $json.server }}\n- Timestamp: {{ $json.timestamp }}\n\n**Backup Status:**\n{{ JSON.stringify($json.backup, null, 2) }}\n\n**WAL Operations:**\n{{ JSON.stringify($json.wal, null, 2) }}\n\n**Replication Health:**\n{{ JSON.stringify($json.replication, null, 2) }}\n\n**Archive Mode:**\n{{ $json.archive_mode }}\n\n**Analysis Requirements:**\n1. Focus on backup integrity and recovery readiness\n2. Analyze WAL archiving and transaction log health\n3. Evaluate replication lag and standby server status\n4. Assess disaster recovery preparedness\n5. Identify backup strategy optimization opportunities\n6. Prioritize findings by recovery impact (Critical, High, Medium, Low)\n\n**Output Format:**\nProvide a focused analysis of backup and recovery issues with:\n- Issue title and priority\n- Brief description of the backup/recovery problem\n- Specific remediation steps for backup optimization\n- Disaster recovery testing and validation recommendations\n- Preventive monitoring and alerting improvements\n\nExpectation: Use the format_final_json_response tool to output a list of backup and recovery issues only.",
        "options": {
          "systemMessage": "You are a Disaster Recovery Specialist with expertise in:\n- PostgreSQL backup strategies and implementation\n- WAL archiving and point-in-time recovery\n- Replication setup and monitoring\n- Disaster recovery planning and testing\n- Backup integrity validation\n\nAnalyze backup and recovery metrics and generate actionable insights focused on:\n- Backup completion status and integrity\n- WAL archiving effectiveness\n- Replication health and lag monitoring\n- Recovery point objectives (RPO) and recovery time objectives (RTO)\n- Disaster recovery readiness assessment\n\nStructure your response to facilitate creation of prioritized Jira tasks for backup and disaster recovery improvements."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5904,
        816
      ],
      "id": "38f501f0-617a-4206-bff8-04f61bb15ae1",
      "name": "Backup Recovery Agent",
      "executeOnce": false,
      "retryOnFail": false
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are a Database Security Analyst specializing in PostgreSQL configuration security and compliance.\n\nInput: Using 'taskbreakdown' tool, analyze the provided security and compliance metrics for PostgreSQL/EnterpriseDB Advanced Server 9.6.\n\n**Server Info:**\n- Server: {{ $json.server }}\n- Timestamp: {{ $json.timestamp }}\n\n**Configuration Settings:**\n{{ JSON.stringify($json.configuration, null, 2) }}\n\n**Security Alerts:**\n{{ JSON.stringify($json.security_alerts, null, 2) }}\n\n**All Alerts (for context):**\n{{ JSON.stringify($json.all_alerts, null, 2) }}\n\n**Analysis Requirements:**\n1. Focus on security configuration vulnerabilities\n2. Analyze authentication and authorization settings\n3. Evaluate compliance with security best practices\n4. Assess privilege escalation risks\n5. Identify data protection and encryption gaps\n6. Prioritize findings by security impact (Critical, High, Medium, Low)\n\n**Output Format:**\nProvide a focused analysis of security and compliance issues with:\n- Issue title and priority\n- Brief description of the security/compliance problem\n- Specific remediation steps for security hardening\n- Compliance alignment recommendations\n- Preventive security monitoring and auditing improvements\n\nExpectation: Use the format_final_json_response tool to output a list of security and compliance issues only.",
        "options": {
          "systemMessage": "You are a Database Security Analyst with expertise in:\n- PostgreSQL security hardening and best practices\n- Authentication and authorization configuration\n- Data encryption and protection mechanisms\n- Compliance frameworks (SOX, HIPAA, PCI-DSS)\n- Security auditing and monitoring\n- Vulnerability assessment and risk analysis\n\nAnalyze security and compliance metrics and generate actionable insights focused on:\n- Security configuration vulnerabilities\n- Authentication and authorization weaknesses\n- Data protection and encryption gaps\n- Compliance violation identification\n- Security monitoring and alerting gaps\n\nStructure your response to facilitate creation of prioritized Jira tasks for security and compliance improvements."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5904,
        1200
      ],
      "id": "89c25869-d614-4275-b7b4-9d1033fa1f46",
      "name": "Security Compliance Agent",
      "executeOnce": false,
      "retryOnFail": false
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are a Senior Database Architect and Analysis Coordinator specializing in PostgreSQL comprehensive health assessment.\n\nInput: Analyze the consolidated findings from all specialized sub-agents for PostgreSQL/EnterpriseDB Advanced Server 9.6.\n\n**Server Info:**\n- Server: {{ $json.server }}\n- Timestamp: {{ $json.timestamp }}\n\n**Consolidation Summary:**\n- Total Issues Found: {{ $json.total_issues }}\n- Issues by Category: {{ JSON.stringify($json.issues_by_category, null, 2) }}\n\n**All Issues (Consolidated & Deduplicated):**\n{{ JSON.stringify($json.issues, null, 2) }}\n\n**Analysis Requirements:**\n1. Synthesize findings from all specialized sub-agents (System Health, Database Performance, Backup & Recovery, Security & Compliance, Storage & Capacity)\n2. Identify cross-category dependencies and related issues\n3. Re-prioritize issues based on overall business impact and interdependencies\n4. Consolidate remediation strategies to avoid conflicting recommendations\n5. Generate comprehensive monitoring and preventive strategy\n6. Focus on actionable insights for database administrators\n\n**Output Format:**\nProvide a comprehensive analysis with:\n- Executive summary of overall database health\n- Prioritized list of all issues (Critical → High → Medium → Low)\n- Consolidated remediation steps that address multiple issues efficiently\n- Preventive monitoring and maintenance recommendations\n- Long-term optimization strategy\n\n**Priority Guidelines:**\n- Critical: Immediate action required, potential data loss or service outage\n- High: Significant performance impact or security risk, address within 24-48 hours\n- Medium: Important optimization opportunities, address within 1-2 weeks\n- Low: Best practice improvements, address during maintenance windows\n\nExpectation: Use the format_final_json_response tool to output a final consolidated list of prioritized issues with comprehensive remediation strategy.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a Senior Database Architect with comprehensive expertise in:\n- PostgreSQL enterprise architecture and design\n- Cross-domain performance optimization\n- Security and compliance integration\n- Disaster recovery and business continuity\n- Capacity planning and scalability\n- Database lifecycle management\n\nSynthesize specialized analyses into cohesive strategy focused on:\n- Holistic database health assessment\n- Multi-domain issue correlation and prioritization\n- Efficient remediation planning\n- Comprehensive monitoring strategy\n- Long-term optimization roadmap\n\nStructure your response to facilitate creation of prioritized Jira tasks with clear business justification and implementation roadmap."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        7120,
        1008
      ],
      "id": "ecc469eb-b8f4-4e77-82ce-8df6f803ff17",
      "name": "Consolidation AI Agent",
      "executeOnce": true,
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const jiraTasks = [];\nconst inputItems = $input.all();\n\nfor (const item of inputItems) {\n    if (item.json.output && Array.isArray(item.json.output)) {\n        for (const issue of item.json.output) {\n            const description = [\n                `Description`,\n                issue.Description || 'No description provided.',\n                ``,\n                `Immediate Remediation Steps`\n            ].concat(issue['Immediate remediation steps'] || ['No immediate remediation steps provided.']).map(step => ` ${step}`)\n            .concat([\n                ``,\n                `Preventative Actions and Proactive Monitoring Improvements`\n            ])\n            .concat(issue['Preventative actions and proactive monitoring improvements'] || ['No preventative actions provided.']).map(action => ` ${action}`)\n            .join(String.fromCharCode(10));\n\n            // Map priority: Critical=1, High=2, Medium=3\n            const priStr = (issue.Priority || 'Medium').toLowerCase();\n            const priorityMap = { critical: 1, high: 2, medium: 3 };\n            const numericPriority = priorityMap[priStr] ?? 3;\n\n            // Only create Jira tasks for priority 1 (Critical) and 2 (High)\n            if (numericPriority <= 3) {\n                const task = {\n                    summary: issue.Issue || 'No summary provided.',\n                    description: description,\n                    priority: numericPriority,\n                    labels: (issue.Issue || '').toLowerCase().split(' ').map(l => l.replace(/[^a-z0-9]/g, ''))\n                };\n                jiraTasks.push({ json: task });\n            }\n            // Else: skip Medium (3) and lower priorities\n        }\n    }\n}\n\nreturn jiraTasks;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7872,
        1008
      ],
      "id": "5370f336-9400-499b-91df-fcfd626b632f",
      "name": "Code in JavaScript"
