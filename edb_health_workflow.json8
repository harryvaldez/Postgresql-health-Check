    {
      "parameters": {
        "numberInputs": 5
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        6496,
        928
      ],
      "id": "aeda52bd-10a8-4425-8138-fcc8ef469b1e",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "// Consolidation Code - Aggregate all sub-agent outputs\nconst systemHealthIssues = $node['System Health Agent'].json?.issues ?? [];\nconst dbPerformanceIssues = $node['DB Performance Agent'].json?.issues ?? [];\nconst backupRecoveryIssues = $node['Backup Recovery Agent'].json?.issues ?? [];\nconst securityComplianceIssues = $node['Security Compliance Agent'].json?.issues ?? [];\nconst storageCapacityIssues = $node['Storage Capacity Agent'].json?.issues ?? [];\n\n// Get server info from any input (they all have the same server info)\nconst serverInfo = $input.first().json;\nconst server = serverInfo.server ?? 'Unknown';\nconst timestamp = serverInfo.timestamp;\n\n// Combine all issues\nconst allIssues = [\n  ...systemHealthIssues.map(issue => ({ ...issue, category: 'System Health' })),\n  ...dbPerformanceIssues.map(issue => ({ ...issue, category: 'Database Performance' })),\n  ...backupRecoveryIssues.map(issue => ({ ...issue, category: 'Backup & Recovery' })),\n  ...securityComplianceIssues.map(issue => ({ ...issue, category: 'Security & Compliance' })),\n  ...storageCapacityIssues.map(issue => ({ ...issue, category: 'Storage & Capacity' }))\n];\n\n// Remove duplicates based on title\nconst uniqueIssues = allIssues.filter((issue, index, self) => \n  index === self.findIndex(i => i.title === issue.title)\n);\n\n// Sort by priority (Critical first, then High, Medium, Low)\nconst priorityOrder = { 'Critical': 1, 'High': 2, 'Medium': 3, 'Low': 4 };\nconst sortedIssues = uniqueIssues.sort((a, b) => \n  (priorityOrder[a.priority] || 5) - (priorityOrder[b.priority] || 5)\n);\n\nconst consolidationData = {\n  server,\n  timestamp,\n  total_issues: sortedIssues.length,\n  issues_by_category: {\n    'System Health': systemHealthIssues.length,\n    'Database Performance': dbPerformanceIssues.length,\n    'Backup & Recovery': backupRecoveryIssues.length,\n    'Security & Compliance': securityComplianceIssues.length,\n    'Storage & Capacity': storageCapacityIssues.length\n  },\n  issues: sortedIssues\n};\n\nreturn [{ json: consolidationData }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6752,
        960
      ],
      "id": "5a9c86fe-eec4-4891-9337-01a0e2afe798",
      "name": "Merge Code Issues",
      "parameters": {
        "jsCode": "const allIssues = [];\nfor (const item of $items) {\n  if (item.json.issues) {\n    allIssues.push(...item.json.issues);\n  }\n}\nconst issuesByCategory = allIssues.reduce((acc, issue) => {\n  const category = issue.category || 'Uncategorized';\n  if (!acc[category]) {\n    acc[category] = [];\n  }\n  acc[category].push(issue);\n  return acc;\n}, {});\n\nreturn [{ json: { issuesByCategory } }];"
      }
    }
  ],
