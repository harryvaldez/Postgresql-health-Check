        1728
      ],
      "id": "946b7907-ef1b-46a4-9b3b-2f482aba4064",
      "name": "If",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst inputData = item.json ?? item;\n\nconst envelope = inputData;\n\nfunction bytesToHuman(bytes) {\n  const value = Number(bytes);\n  if (!Number.isFinite(value)) return null;\n  const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];\n  let unitIndex = 0;\n  let n = value;\n  while (n >= 1024 && unitIndex < units.length - 1) {\n    n /= 1024;\n    unitIndex += 1;\n  }\n  const rounded = unitIndex === 0 ? n.toFixed(0) : n.toFixed(2);\n  return `${rounded} ${units[unitIndex]}`;\n}\n\nfunction pickMetricsBody(env) {\n  if (env?.body?.body?.data?.data) return env.body.body.data.data;\n  if (env?.body?.data?.data) return env.body.data.data;\n  if (env?.body?.data) return env.body.data;\n  if (env?.body) return env.body;\n  if (env?.data) return env.data;\n  return env;\n}\n\nlet metricsBody = pickMetricsBody(envelope);\nif (metricsBody?.data && typeof metricsBody.data === 'object') metricsBody = metricsBody.data;\n\nconst jwtPayload = envelope.jwtPayload ?? metricsBody?.jwtPayload ?? null;\nconst serverName = jwtPayload?.server_name ?? jwtPayload?.server_ip ?? metricsBody?.hostname ?? metricsBody?.server_name ?? metricsBody?.server ?? 'Unknown';\nconst timestamp = metricsBody?.timestamp ?? jwtPayload?.timestamp ?? null;\n\nconst system = metricsBody?.system ?? {};\nconst memory = system?.memory_mb ?? {};\nconst totalMem = Number(memory.total);\nconst usedMem = Number(memory.used);\nconst memUsedPct = Number.isFinite(totalMem) && totalMem > 0 && Number.isFinite(usedMem) ? (usedMem / totalMem) * 100 : null;\n\nconst performance = metricsBody?.performance ?? {};\nconst databaseStatus = metricsBody?.database_status ?? {};\nconst locks = metricsBody?.locks ?? {};\nconst replication = metricsBody?.replication ?? {};\nconst backup = metricsBody?.backup ?? {};\n\nconst storage = metricsBody?.storage ?? {};\nconst databaseSizeBytes = storage?.database_size?.database_size_bytes ?? null;\nconst tempTotalBytes = storage?.temp_objects?.temp_objects_total_bytes ?? null;\nconst tempObjectsCount = storage?.temp_objects?.temp_objects_count ?? null;\n\nconst largestTables = Array.isArray(storage?.largest_tables) ? storage.largest_tables : [];\nconst largestIndexes = Array.isArray(storage?.largest_indexes) ? storage.largest_indexes : [];\n\nconst storageSummary = {\n  database_size_bytes: databaseSizeBytes,\n  database_size_human: storage?.database_size?.database_size ?? bytesToHuman(databaseSizeBytes),\n  temp_objects_total_bytes: tempTotalBytes,\n  temp_objects_total_human: storage?.temp_objects?.temp_objects_total_size ?? bytesToHuman(tempTotalBytes),\n  temp_objects_count: tempObjectsCount,\n  largest_tables_top: largestTables.slice(0, 10).map(t => ({\n    name: t?.schemaname && t?.table_name ? `${t.schemaname}.${t.table_name}` : (t?.table_name ?? 'Unknown'),\n    total_bytes: t?.total_bytes ?? null,\n    total_size: t?.total_size ?? bytesToHuman(t?.total_bytes)\n  })),\n  largest_indexes_top: largestIndexes.slice(0, 10).map(i => ({\n    name: i?.schemaname && i?.index_name ? `${i.schemaname}.${i.index_name}` : (i?.index_name ?? 'Unknown'),\n    table_name: i?.table_name ?? null,\n    index_bytes: i?.index_bytes ?? null,\n    index_size: i?.index_size ?? bytesToHuman(i?.index_bytes)\n  }))\n};\n\nconst summary = {\n  server: serverName,\n  timestamp,\n  service_status: databaseStatus?.service_status ?? null,\n  connection_status: databaseStatus?.connection_status ?? null,\n  disk_usage_percent: system?.disk_usage_percent ?? null,\n  load_avg_1min: system?.load_avg?.['1min'] ?? null,\n  memory_used_percent: memUsedPct === null ? null : Number(memUsedPct.toFixed(2)),\n  total_connections: performance?.total_connections ?? null,\n  active_connections: performance?.active_connections ?? null,\n  long_running_queries_count: performance?.long_running_queries_count ?? null,\n  cache_hit_ratio: performance?.cache_hit_ratio ?? null,\n  waiting_sessions: locks?.waiting_sessions ?? null,\n  deadlocks: metricsBody?.database?.stats?.deadlocks ?? null,\n  connected_replicas: replication?.connected_replicas ?? null,\n  archive_mode: backup?.archive_mode ?? null\n};\n\nconst alerts = [];\nif (databaseStatus?.service_status && String(databaseStatus.service_status).toLowerCase() !== 'active') {\n  alerts.push({ severity: 'critical', code: 'service_not_active', message: 'Database service is not active', value: databaseStatus.service_status });\n}\nif (databaseStatus?.connection_status && String(databaseStatus.connection_status).toLowerCase() !== 'success') {\n  alerts.push({ severity: 'critical', code: 'connection_failed', message: 'Database connection did not succeed', value: databaseStatus.connection_status });\n}\nconst diskUsage = Number(system?.disk_usage_percent);\nif (Number.isFinite(diskUsage) && diskUsage >= 90) {\n  alerts.push({ severity: 'critical', code: 'disk_usage_high', message: 'Disk usage is >= 90%', value: diskUsage });\n} else if (Number.isFinite(diskUsage) && diskUsage >= 80) {\n  alerts.push({ severity: 'warning', code: 'disk_usage_elevated', message: 'Disk usage is >= 80%', value: diskUsage });\n}\n\nconst normalizedBody = {\n  ...metricsBody,\n  summary,\n  storage_summary: storageSummary,\n  alerts\n};\n\nconst output = {\n  ...envelope,\n  body: normalizedBody,\n  jwtPayload: jwtPayload ?? envelope.jwtPayload\n};\n\nreturn [{ json: output }];\n"
      },
